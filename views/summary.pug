extends layout

block layout-content
  div.View
    h1.Banner Summary:
    div.Message
      div.Title
        h3 You have this income: #{totalIncome}
        h1 And these expenses: #{totalExpenses}
      span.Details You have #{disposable} left!
    div.NavButtons
      a(href="/user")
          div.NavButton

    div
    canvas#expensesChart

    script(src="https://cdn.jsdelivr.net/npm/chart.js")

    script.
        const ctx = document.getElementById('expensesChart');

        new Chart(ctx, {
            type: 'pie',
            data: {
            labels: ['Housing', 'Loan', 'Utilities', 'Insurance', 'Transportation', 'Groceries', 'Clothing', 'Media / Subscriptions', 'Hobbies / Sports', 'Retirement savings', 'Buffer', 'Other savings'],
            datasets: [{
                data: [12, 19, 3, 5, 2, 3],
                borderWidth: 1
            }]
            },
        });

    