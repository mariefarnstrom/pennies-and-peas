extends layout

block layout-content
  div.View

    div.Message
      div.Title
        h3 About Pennies and Peas, your friendly budget helper!
      span.Details We exist in order to help all who are new to a budget, who find budgeting 
      |daunting and need a hand to take the first steps. Just fill in the forms with your expenses 
      |and your income and we will calculate your total income and total expenses. based on this we will the give you a pie! Well, a pie chart to be honest and show how your spending looks. 
      |like and where we think changes might be neccessary. by making things more visualy available you csn then make informed decisions. Maybe you are overspending on things when you gould get discounts? 
      |Maybe you do have. agood budget but the money is simply not enough? Then we will help with links and information on how you can find recourses and find help. Money is ha difficult and vulnerbule topic 
      |and we want to help you make the best decitions available to you. So lets start and save some pennies!  

    div.NavButtons
      a(href="/user")
          div.NavButton Future login?
    div.IncomesForm

    div.income-container 
      h2 Income 
  
      form(action="/incomes" method="POST")
        label(for="incomes") Salary:
        input(type="number" name="incomes[salary]")
        label(for="incomes") Benefits:
        input(type="number" name="incomes[benefits]")
        label(for="incomes") Other income:
        input(type="number" name="incomes[other]")
        button(type="submit") Add income

    form(action="/expenses" method="POST")
      h2 Expenses

      div.expenses-grid

        div.column
          h3 Fixed costs
          label Rent / Housing
          input(type="number" name="expenses[housing]")

          label Loan payments
          input(type="number" name="expenses[loans]")

          label Utilities
          input(type="number" name="expenses[utilities]")

          label Insurance
          input(type="number" name="expenses[insurance]")

          label Transportation
          input(type="number" name="expenses[transportation]")

        div.column
          h3 Variable costs
          label Groceries
          input(type="number" name="expenses[groceries]")

          label Clothing
          input(type="number" name="expenses[clothing]")

          label Subscriptions / Media
          input(type="number" name="expenses[media]")

          label Hobbies / Sports
          input(type="number" name="expenses[hobbies]")

        div.column
          h3 Savings
          label Retirement savings
          input(type="number" name="expenses[retirement]")

          label Buffer
          input(type="number" name="expenses[buffer]")

          label Other savings
          input(type="number" name="expenses[other]")

        button(type="submit") Calculate budget

