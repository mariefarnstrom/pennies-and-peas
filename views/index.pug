extends layout

block layout-content
  div.View
    h1.Banner Pennies and Peas
    div.Message
      div.Title
        h3 Get rich
        h1 or die
      span.Details trying!
    div.NavButtons
      a(href="/user")
          div.NavButton Just dive in!
    form(action="/incomes" method="POST")
        label(for="incomes") Incomes:
        input(type="number" name="income")
        button(type="submit") Add income
    form(action="/expenses" method="POST")
        label(for="expenses") Expenses:
        input(type="number" name="expense")
        button(type="submit") Calculate budget